{
  "name": "bb-plugin-auto-title",
  "version": "0.4.0",
  "type": "module",
  "engines": {
    "bb": ">=0.50.1",
    "bbPluginSdk": ">=0.6.157"
  },
  "bb": {
    "name": "Auto Title",
    "description": "Rechecks thread titles every few human messages and renames only when the title no longer fits.",
    "branding": {
      "icon": "./assets/icon.svg"
    },
    "server": "./server.ts",
    "skills": [
      "./skills/auto-title"
    ],
    "app": "./app.tsx"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.157",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "better-sqlite3": "^12.11.1",
    "cron-parser": "^5.10.2",
    "hono": "^4.13.13",
    "react": "^19.3.1",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "build": "bb plugin build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "license": "MIT",
  "description": "Checks BB thread titles as the conversation changes."
}
